# Copy this file to .env for local development.
# Only browser-safe/public client configuration belongs in VITE_* variables.
# Never place service-role keys or other server-side secrets in VITE_* values.

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
